<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h"/>

  <!--this header contains the command ids for the menus provided the engine picker menu -->
  <Extern href="vsshlids.h"/>
  <Extern href="VSDbgCmd.h"/>
  <Extern href="VsDebugGuids.h"/>

  <Commands package="guidRADPackage">
    <Groups>
      <Group guid="guidRADPackageCmdSet" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidVSDebugGroup" id="IDM_DEBUG_MENU"/>
      </Group>
      <Group guid="guidRADPackageCmdSet" id="DebugEngineGroup" priority="0x0100">
        <Parent guid="guidRADPackageCmdSet" id="DebugEngineMenu"/>
      </Group>
    </Groups>

    <Menus>
      <Menu guid="guidRADPackageCmdSet" id="DebugEngineMenu" priority="0x0100" type="Menu">
        <Parent guid="guidRADPackageCmdSet" id="MyMenuGroup" />
        <Strings>
          <ButtonText>Debug Engine</ButtonText>
		  <CommandName>Debug Engine</CommandName>
        </Strings>
      </Menu>
    </Menus>

    <Buttons>
      <Button guid="guidRADPackageCmdSet" id="NativeEngineId" priority="0x0100" type="Button">
        <Parent guid="guidRADPackageCmdSet" id="DebugEngineGroup" />
        <Strings>
          <ButtonText>Native</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidRADPackageCmdSet" id="RadEngineId" priority="0x0200" type="Button">
        <Parent guid="guidRADPackageCmdSet" id="DebugEngineGroup" />
        <Strings>
          <ButtonText>RAD</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="guidRADPackage" value="{78083fc7-5620-4c90-a77f-fdf476429014}" />

    <GuidSymbol name="guidRADPackageCmdSet" value="{c19e4a06-d36b-48b6-baf7-7e37a824e803}">
      <IDSymbol name="MyMenuGroup" value="0x1020" />
      <IDSymbol name="DebugEngineMenu" value="0x1021" />
      <IDSymbol name="DebugEngineGroup" value="0x1022" />
      <IDSymbol name="NativeEngineId" value="0x0100" />
      <IDSymbol name="RadEngineId" value="0x0101" />
    </GuidSymbol>

  </Symbols>
</CommandTable>
